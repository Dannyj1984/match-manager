# Database Configuration (Must match what you set in postgres container or external DB)
DB_USER=fairplay_user
DB_PASSWORD=secure_password_here
DB_NAME=fairplay_db

# JWT Security
JWT_KEY=change_this_to_a_very_long_random_string_for_production
JWT_ISSUER=EvenPlayApi

# Frontend Configuration
AUTH_ORIGIN=https://evenplay.app

# CORS Configuration (Comma separated list of allowed origins)
AllowedOrigins=https://evenplay.app,https://www.evenplay.app,http://localhost:3000

# Internal Proxy (Usually doesn't need changing if using docker-compose.prod.yml)
NUXT_API_PROXY_TARGET=http://evenplay-backend:5000/api/**
